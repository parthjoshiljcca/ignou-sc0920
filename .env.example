# Neon Postgres connection string (Neon dashboard → Connection Details → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Long random string used to sign login sessions. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Coordinator (admin) account created by `npm run db:seed`
ADMIN_NAME="Assistant Coordinator"
ADMIN_EMAIL="coordinator@example.com"
ADMIN_PASSWORD="change-me-now"

# Web push (optional but recommended). Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:coordinator@example.com"
